generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(1)
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ChatRole {
  USER
  ASSISTANT
}

enum UrssafPeriod {
  MONTHLY
  QUARTERLY
}

enum Plan {
  FREE
  PAID
}

enum DocumentType {
  QUOTE
  INVOICE
}

enum DocumentStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum ProspectStatus {
  TO_CONTACT
  CONTACTED
  IN_DISCUSSION
  WON
  LOST
}

enum RecommendationPriority {
  HIGH
  MEDIUM
  LOW
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  avatarUrl     String?
  cotisationRate Float    @default(0)
  acreEligible  Boolean   @default(false)
  companyName    String?
  companyAddress String?
  siren          String?
  vatApplicable  Boolean   @default(false)
  urssafPeriod         UrssafPeriod @default(MONTHLY)
  urssafDeclarationDay Int?
  bridgeUserUuid    String?
  bridgeLastSyncAt  DateTime?
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tasks         Task[]
  events        Event[]
  notes         Note[]
  conversations ChatConversation[]
  documents     Document[]
  googleAccount GoogleAccount?
  resetTokens   PasswordResetToken[]
  actionPlan    ActionPlan?
  forecastEntries ForecastEntry[]
  businessPlan  BusinessPlan?
  prospects     Prospect[]
  recommendations Recommendation[]
  pricingSettings PricingSettings?
  startupCosts     StartupCost[]
  financingSources FinancingSource[]
  monthlyCharges   MonthlyCharge[]
  productMargins   ProductMargin[]
  dailyBriefings   DailyBriefing[]
  bankAccounts     BankAccount[]
}

model BankAccount {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bridgeAccountId String   @unique
  bridgeItemId    String
  name            String
  type            String
  iban            String?
  balance         Float
  currencyCode    String
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  transactions BankTransaction[]

  @@index([userId])
}

model BankTransaction {
  id                  String      @id @default(cuid())
  bankAccountId       String
  bankAccount         BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bridgeTransactionId String      @unique
  description         String
  amount              Float
  date                DateTime
  currencyCode        String
  createdAt           DateTime    @default(now())

  matchedDocumentId String?
  matchedDocument   Document? @relation(fields: [matchedDocumentId], references: [id], onDelete: SetNull)

  @@index([bankAccountId])
  @@index([matchedDocumentId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

model Event {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  location      String?
  googleEventId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model GoogleAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String?
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  content    String
  summary    String?
  sourceType String   @default("manual")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("Nouvelle conversation")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}

model Document {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          DocumentType
  number        String
  status        DocumentStatus @default(DRAFT)
  clientName    String
  clientEmail   String?
  clientAddress String?
  clientSiren   String?
  issueDate     DateTime       @default(now())
  dueDate       DateTime?
  notes         String?
  taxRate       Float          @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  superpdpInvoiceId   String?
  superpdpSentAt      DateTime?
  superpdpCompanyName String?

  items             DocumentItem[]
  matchedTransactions BankTransaction[]

  @@index([userId])
}

model DocumentItem {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  position    Int      @default(0)
}

model ActionPlan {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      String
  context   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  steps     ActionPlanStep[]
}

model ActionPlanStep {
  id          String     @id @default(cuid())
  planId      String
  plan        ActionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title       String
  description String?
  done        Boolean    @default(false)
  position    Int        @default(0)
  createdAt   DateTime   @default(now())

  @@index([planId])
}

model ForecastEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     DateTime
  revenue   Float    @default(0)
  expenses  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId])
}

model Prospect {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  company         String?
  email           String?
  phone           String?
  channel         String?
  status          ProspectStatus @default(TO_CONTACT)
  notes           String?
  outreachMessage String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
}

model PricingSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetNetIncome     Float    @default(0)
  workingDaysPerMonth Float    @default(18)
  hoursPerDay         Float    @default(7)
  monthlyExpenses     Float    @default(0)
  updatedAt           DateTime @updatedAt
}

model Recommendation {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  priority    RecommendationPriority @default(MEDIUM)
  done        Boolean                @default(false)
  createdAt   DateTime               @default(now())

  @@index([userId])
}

model StartupCost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  amount    Float    @default(0)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model FinancingSource {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  amount    Float    @default(0)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model MonthlyCharge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  amount    Float    @default(0)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ProductMargin {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  unitPrice     Float    @default(0)
  unitCost      Float    @default(0)
  monthlyVolume Float    @default(0)
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([userId])
}

model DailyBriefing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  content   String
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

model BusinessPlan {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectName  String
  summary      String
  presentation String
  offer        String
  market       String
  strategy     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
